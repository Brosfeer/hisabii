{
  "expo": {
    "name": "hisabi",
    "slug": "hisabi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hisabi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sayasky.hisabi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sayasky.hisabi"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/thmanyahsans-Regular.otf",
            "./assets/fonts/thmanyahsans-Medium.otf",
            "./assets/fonts/thmanyahsans-Bold.otf",
            "./assets/fonts/thmanyahseriftext-Regular.otf",
            "./assets/fonts/thmanyahseriftext-Medium.otf",
            "./assets/fonts/thmanyahseriftext-Bold.otf",
            "./assets/fonts/thmanyahserifdisplay-Regular.otf",
            "./assets/fonts/thmanyahserifdisplay-Bold.otf",
            "./assets/fonts/thmanyahserifdisplay-Black.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
